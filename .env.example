DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

NEXTAUTH_SECRET="generate_a_random_secret_string"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------
# 🎬 1. TMDB (Movies & TV Shows & Anime)
# Get key from: https://www.themoviedb.org/settings/api
# ----------------------------------------------------
TMDB_API_KEY="your_v3_api_key_here"

# ----------------------------------------------------
# 🎮 2. RAWG (Games)
# Get key from: https://rawg.io/apidocs
# ----------------------------------------------------
RAWG_API_KEY="your_rawg_api_key_here"

# ----------------------------------------------------
# 📚 3. Google Books API (Books)
# Get key from: https://console.cloud.google.com/
# ----------------------------------------------------
GOOGLE_BOOKS_API_KEY="your_google_books_api_key"

# ----------------------------------------------------
# 🚂 4. Steam API (Syncing Steam Games)
# Get key from: https://steamcommunity.com/dev/apikey
# ----------------------------------------------------
STEAM_API_KEY="your_steam_api_key_here"

# ----------------------------------------------------
# 🔑 5. Google Login (Optional)
# Get keys from: https://console.cloud.google.com/
# ----------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
