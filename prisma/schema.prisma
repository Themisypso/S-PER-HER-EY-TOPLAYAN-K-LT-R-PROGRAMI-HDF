// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH (NextAuth)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  username      String?   @unique
  steamId       String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Extended profile fields (per spec)
  avatarUrl String?
  bio       String? @db.Text

  // Integration fields
  malUsername     String?
  malAccessToken  String?  @db.Text
  malRefreshToken String?  @db.Text
  anilistUsername String?
  anilistToken    String?  @db.Text
  tmdbSessionId   String?

  accounts   Account[]
  sessions   Session[]
  mediaItems MediaItem[]

  // Settings & profile
  settings         UserSettings?
  followers        Follows[]        @relation("followers")
  following        Follows[]        @relation("following")
  activities       Activity[]
  quotes           Quote[]
  submittedReports Report[]         @relation("ReportedBy")
  favoritePeople   FavoritePerson[]
  favoriteMedia    FavoriteMedia[]

  // Social & Sharing Features
  lists                  List[]
  sentFriendRequests     FriendRequest[]            @relation("SentRequests")
  receivedFriendRequests FriendRequest[]            @relation("ReceivedRequests")
  friendships            Friendship[]               @relation("UserFriendships")
  friendshipsOf          Friendship[]               @relation("FriendOf")
  sharedSessionsHosted   SharedSession[]            @relation("HostOfSession")
  sharedSessionLinks     SharedSessionParticipant[]

  // Interactions (Likes, Comments, Notifications)
  quoteLikes      QuoteLike[]
  commentLikes    CommentLike[]
  listLikes       ListLike[]
  comments        Comment[]
  notifications   Notification[] @relation("UserNotifications")
  triggeredNotifs Notification[] @relation("ActorNotifications")

  // Discussions
  discussionThreads DiscussionThread[] @relation("ThreadAuthor")

  // New social models
  likes       Like[]
  discussions Discussion[]

  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// ENUMS
// ============================================================

enum MediaType {
  ANIME
  MOVIE
  TVSHOW
  GAME
  BOOK
}

enum MediaStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum Theme {
  LIGHT
  DARK
  CYBERPUNK
  RETROWAVE
}

enum ActivityType {
  REVIEW
  PROGRESS_UPDATE
  STATUS_CHANGE
  QUOTE
  ADDED_MEDIA
  RATED
  NOTE_ADDED
  EPISODE_COMPLETED
  GAME_COMPLETED
  BOOK_COMPLETED
  FAVORITED_PERSON
  LIST_CREATED
  // New activity types per spec
  WATCH
  RATING
  LIST
  DISCUSSION
  FAVORITE
}

enum ReportTargetType {
  USER
  MEDIA_ITEM
  QUOTE
  ACTIVITY
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum AttachmentType {
  NONE
  IMAGE
  GIF
  VIDEO
}

enum NotificationType {
  LIKE_QUOTE
  LIKE_LIST
  LIKE_COMMENT
  LIKE_DISCUSSION
  COMMENT_QUOTE
  COMMENT_DISCUSSION
  MENTION
  REPLY
  FOLLOW
}

// ============================================================
// CORE MEDIA CATALOGUE (shared, not per-user)
// ============================================================

/// Unified external media catalogue. Not per-user — shared across all users.
/// Source examples: tmdb, rawg, googlebooks, manual
/// Type examples: movie, tv, anime, game, book
model Media {
  id            String    @id @default(cuid())
  externalId    String?
  source        String // "tmdb" | "rawg" | "googlebooks" | "manual"
  type          String // "movie" | "tv" | "anime" | "game" | "book"
  title         String
  originalTitle String?
  description   String?   @db.Text
  posterUrl     String?
  backdropUrl   String?
  releaseDate   DateTime?
  runtime       Int?
  popularity    Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  genres      MediaGenre[]
  mediaItems  MediaItem[]
  listItems   ListItem[]
  discussions Discussion[]
  stats       MediaStats?

  @@index([externalId])
  @@index([type])
}

// ============================================================
// GENRES (normalized)
// ============================================================

model Genre {
  id   String @id @default(cuid())
  name String @unique

  media MediaGenre[]
}

model MediaGenre {
  mediaId String
  genreId String

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
  @@index([mediaId])
  @@index([genreId])
}

// ============================================================
// USER LIBRARY (tracking system)
// ============================================================

/// Per-user media tracking. Mapped to "user_media" table.
/// Prisma model name kept as MediaItem for API backward-compatibility.
model MediaItem {
  id     String      @id @default(cuid())
  userId String
  title  String
  type   MediaType
  status MediaStatus @default(PLANNED)

  // TMDB / External IDs
  tmdbId     String?
  imdbId     String?
  rawgId     String? // RAWG game ID (slug)
  bookId     String? // Google Books volumeId
  steamAppId String? // Steam App ID for games

  // Optional link to shared Media catalogue
  mediaId String?

  // Media metadata
  posterUrl   String?
  backdropUrl String?
  genres      String[]
  releaseYear Int?
  overview    String?  @db.Text
  tmdbRating  Float?

  // Time tracking
  runtime              Int? // minutes (movies/episodes)
  episodeCount         Int? // anime/TV shows
  episodeDuration      Int? // minutes per episode
  playtimeHours        Float? // games (manual)
  steamPlaytimeMinutes Int? // games (steam sync)
  totalTimeMinutes     Int? // computed

  // User data
  userRating Int? // 1-10
  notes      String? @db.Text

  // Progress tracking
  progress       Int? // Current minute, page, or episode
  pageCount      Int? // For books
  lastProgressAt DateTime? // Timestamp of last progress update

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isFeatured   Boolean  @default(false)
  isSpoiler    Boolean  @default(false)
  originalLang String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media             Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  activities        Activity[]
  quotes            Quote[]
  discussionThreads DiscussionThread[]

  @@unique([userId, tmdbId])
  @@index([userId])
  @@index([tmdbId])
  @@index([mediaId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("user_media")
}

// ============================================================
// USER SETTINGS
// ============================================================

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio       String? @db.Text
  website   String?
  twitter   String?
  instagram String?

  isPublic         Boolean @default(true)
  hideRatings      Boolean @default(false)
  hideActivity     Boolean @default(false)
  showSteamProfile Boolean @default(true)

  language String @default("system") // system, tr, en, de, etc.
  theme    Theme  @default(DARK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SOCIAL GRAPH
// ============================================================

model Follows {
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================================
// ACTIVITY FEED
// ============================================================

model Activity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ActivityType

  mediaId String? // Reference to user's MediaItem
  media   MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  // Polymorphic reference fields
  referenceId String? // Legacy: for non-media references (e.g., person ID)
  targetId    String? // New: polymorphic target ID
  targetType  String? // New: "media" | "quote" | "list" | "discussion"

  content      String?  @db.Text
  originalLang String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([mediaId])
  @@index([createdAt])
}

// ============================================================
// QUOTES
// ============================================================

model Quote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaId String
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  content        String         @db.Text
  reference      String? // e.g., "Page 42" or "1:24:00"
  mediaUrl       String? // Legacy: Cloudinary/Supabase URL
  attachmentType AttachmentType @default(NONE)

  // New media attachment fields per spec
  imageUrl     String?
  gifUrl       String?
  videoUrl     String?
  originalLang String?

  // Denormalized like count for fast sorting
  likesCount Int @default(0)

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    QuoteLike[]
  comments Comment[]

  @@index([userId])
  @@index([mediaId])
  @@index([likesCount])
  @@index([createdAt])
}

// ============================================================
// LISTS
// ============================================================

model List {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String? @db.Text
  isPublic    Boolean @default(true) // Legacy field kept for API compat
  isFeatured  Boolean @default(false)
  isSpoiler   Boolean @default(false)

  // New visibility field per spec
  visibility   String  @default("public") // "public" | "private" | "friends"
  originalLang String?

  // Denormalized like count
  likesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]

  @@index([userId])
  @@index([likesCount])
  @@index([createdAt])
}

model ListItem {
  id         String   @id @default(cuid())
  listId     String
  title      String
  posterUrl  String?
  order      Int      @default(0) // Legacy order field
  orderIndex Int      @default(0) // New alias per spec
  createdAt  DateTime @default(now())

  // Legacy external ID fields (kept for API compat)
  tmdbId    String?
  rawgId    String?
  bookId    String?
  mediaType String // "MOVIE", "TVSHOW", "ANIME", "GAME", "BOOK"

  // New FK to shared Media catalogue (optional)
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([mediaId])
}

// ============================================================
// DISCUSSIONS (new — separate from legacy DiscussionThread)
// ============================================================

/// New media discussion model per spec.
/// Separate from DiscussionThread which powers existing discussion routes.
model Discussion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Can be linked to the new shared Media catalogue
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  content      String  @db.Text
  likesCount   Int     @default(0)
  originalLang String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mediaId])
  @@index([createdAt])
}

// ============================================================
// REPORTS
// ============================================================

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)

  targetId   String
  targetType ReportTargetType

  reason String       @db.Text
  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

// ============================================================
// PEOPLE FAVORITES
// ============================================================

model FavoritePerson {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbPersonId       Int
  name               String
  profileUrl         String?
  knownForDepartment String?
  createdAt          DateTime @default(now())

  @@unique([userId, tmdbPersonId])
  @@index([userId])
}

model FavoriteMedia {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      String
  title       String
  type        String // MOVIE, TVSHOW, ANIME
  posterUrl   String?
  releaseYear Int?
  createdAt   DateTime @default(now())

  @@unique([userId, tmdbId])
  @@index([userId])
}

// ============================================================
// FRIEND SYSTEM
// ============================================================

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("UserFriendships", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendOf", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ============================================================
// SHARED LIBRARY SESSIONS
// ============================================================

model SharedSession {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., "ABC-123"
  hostId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  host         User                       @relation("HostOfSession", fields: [hostId], references: [id], onDelete: Cascade)
  participants SharedSessionParticipant[]

  @@index([code])
}

model SharedSessionParticipant {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session SharedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// ============================================================
// SOCIAL INTERACTIONS (Likes & Comments)
// ============================================================

model QuoteLike {
  id        String   @id @default(cuid())
  userId    String
  quoteId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, quoteId])
  @@index([quoteId])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Comment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content      String   @db.Text
  originalLang String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Threaded replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // A comment can belong to a Quote OR a DiscussionThread
  quoteId            String?
  quote              Quote?            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  discussionThreadId String?
  discussionThread   DiscussionThread? @relation(fields: [discussionThreadId], references: [id], onDelete: Cascade)

  likes CommentLike[]

  @@index([userId])
  @@index([quoteId])
  @@index([discussionThreadId])
  @@index([parentId])
  @@index([createdAt])
}

// ============================================================
// UNIVERSAL LIKE SYSTEM (polymorphic)
// ============================================================

/// Universal polymorphic like. targetType: "quote" | "discussion" | "list" | "comment"
model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String // "quote" | "discussion" | "list" | "comment"
  createdAt  DateTime @default(now())

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([userId])
}

// ============================================================
// LEGACY DISCUSSIONS (kept for all existing routes)
// ============================================================

model DiscussionThread {
  id    String  @id @default(cuid())
  title String? // Optional title

  // Author of the thread
  userId String?
  author User?   @relation("ThreadAuthor", fields: [userId], references: [id], onDelete: SetNull)

  // Can be linked to a MediaItem
  mediaId String?
  media   MediaItem? @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  // OR can be linked directly to a tmdbId if the media isn't in anyone's library yet
  tmdbId String?

  // Denormalized media metadata for listing without joins
  mediaTitle     String?
  mediaPosterUrl String?
  mediaType      String? // MOVIE, TVSHOW, ANIME, GAME, BOOK
  originalLang   String?

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]

  @@index([mediaId])
  @@index([tmdbId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String // Receiver
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  actorId String // Person doing the action
  actor   User   @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  type        NotificationType
  referenceId String? // Legacy: ID of the quote, list, or comment

  // New polymorphic target fields per spec
  targetId   String?
  targetType String? // "quote" | "discussion" | "list" | "comment"

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([actorId])
  @@index([userId])
}

// ============================================================
// MEDIA STATISTICS (trending engine)
// ============================================================

/// Aggregated stats per Media for homepage discovery & trending.
model MediaStats {
  mediaId         String @id
  media           Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  views           Int    @default(0)
  quotes          Int    @default(0)
  discussions     Int    @default(0)
  favorites       Int    @default(0)
  listAppearances Int    @default(0)

  // Trending & ranking fields
  trendScore   Float   @default(0)
  weeklyRank   Int? // e.g. 3 = Trending #3 (null = not ranked)
  lastWeekRank Int? // previous week's rank (for delta calculation)
  weeksInTop10 Int     @default(0) // consecutive weeks in the Top 10
  rankType     String? // "movie" | "tv" | "anime" | "game" (null = unranked type)

  updatedAt DateTime @updatedAt

  @@index([trendScore])
  @@index([weeklyRank])
  @@index([rankType, weeklyRank])
}

// ============================================================
// CMS / ADMIN
// ============================================================

model FooterConfig {
  id          String  @id @default(cuid())
  section     String // "Product", "Community", "Company", "Social"
  label       String // e.g., "About"
  url         String // e.g., "/about"
  order       Int     @default(0)
  socialLinks Json?   // {"twitter": "...", "github": "..."}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}


// ============================================================
// TRANSLATION CACHING
// ============================================================

model TranslationCache {
  id           String   @id @default(cuid())
  sourceHash   String   // Hash of the original text (for fast lookup)
  sourceLang   String   
  targetLang   String   
  translated   String   @db.Text
  createdAt    DateTime @default(now())

  @@unique([sourceHash, targetLang])
  @@index([sourceHash])
}

